<?xml version="1.0" ?>
<web-app
		xmlns = "https://jakarta.ee/xml/ns/jakartaee"
		xmlns:xsi = "http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation = "https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_5_0.xsd"
		version = "5.0"
		metadata-complete = "false">
<filter>
	<filter-name>TSI_DX_Node</filter-name>
	<filter-class>org.tsicoop.dxnode.framework.InterceptingFilter</filter-class>
</filter>

<listener>
		<listener-class>org.tsicoop.dxnode.framework.TransferEngine</listener-class>
</listener>
	
<filter-mapping>
	<filter-name>TSI_DX_Node</filter-name>
	<url-pattern>/api/*</url-pattern>
	<dispatcher>REQUEST</dispatcher>
	<dispatcher>FORWARD</dispatcher>
</filter-mapping>

<!--
  Server-side gate for the admin console pages. index.html (login), init.html
  (node setup), password_reset.html and /tour/ stay public.
-->
<filter>
	<filter-name>CONSOLE_AUTH_FILTER</filter-name>
	<filter-class>org.tsicoop.dxnode.framework.ConsoleAuthFilter</filter-class>
</filter>
<filter-mapping>
	<filter-name>CONSOLE_AUTH_FILTER</filter-name>
	<url-pattern>/dashboard.html</url-pattern>
	<dispatcher>REQUEST</dispatcher>
	<dispatcher>FORWARD</dispatcher>
</filter-mapping>
<filter-mapping>
	<filter-name>CONSOLE_AUTH_FILTER</filter-name>
	<url-pattern>/contracts.html</url-pattern>
	<dispatcher>REQUEST</dispatcher>
	<dispatcher>FORWARD</dispatcher>
</filter-mapping>
<filter-mapping>
	<filter-name>CONSOLE_AUTH_FILTER</filter-name>
	<url-pattern>/partners.html</url-pattern>
	<dispatcher>REQUEST</dispatcher>
	<dispatcher>FORWARD</dispatcher>
</filter-mapping>
<filter-mapping>
	<filter-name>CONSOLE_AUTH_FILTER</filter-name>
	<url-pattern>/transfers.html</url-pattern>
	<dispatcher>REQUEST</dispatcher>
	<dispatcher>FORWARD</dispatcher>
</filter-mapping>
<filter-mapping>
	<filter-name>CONSOLE_AUTH_FILTER</filter-name>
	<url-pattern>/consent.html</url-pattern>
	<dispatcher>REQUEST</dispatcher>
	<dispatcher>FORWARD</dispatcher>
</filter-mapping>
<filter-mapping>
	<filter-name>CONSOLE_AUTH_FILTER</filter-name>
	<url-pattern>/apikeys.html</url-pattern>
	<dispatcher>REQUEST</dispatcher>
	<dispatcher>FORWARD</dispatcher>
</filter-mapping>
<filter-mapping>
	<filter-name>CONSOLE_AUTH_FILTER</filter-name>
	<url-pattern>/users.html</url-pattern>
	<dispatcher>REQUEST</dispatcher>
	<dispatcher>FORWARD</dispatcher>
</filter-mapping>
<filter-mapping>
	<filter-name>CONSOLE_AUTH_FILTER</filter-name>
	<url-pattern>/audit.html</url-pattern>
	<dispatcher>REQUEST</dispatcher>
	<dispatcher>FORWARD</dispatcher>
</filter-mapping>
<filter-mapping>
	<filter-name>CONSOLE_AUTH_FILTER</filter-name>
	<url-pattern>/settings.html</url-pattern>
	<dispatcher>REQUEST</dispatcher>
	<dispatcher>FORWARD</dispatcher>
</filter-mapping>

<!--
  Jetty's bundled webdefault-ee10.xml sets dirAllowed=true on the "default"
  servlet, so any directory without a welcome file would be auto-listed.
  Redeclaring "default" overrides just that init-param.
-->
<servlet>
	<servlet-name>default</servlet-name>
	<servlet-class>org.eclipse.jetty.ee10.servlet.DefaultServlet</servlet-class>
	<init-param>
		<param-name>dirAllowed</param-name>
		<param-value>false</param-value>
	</init-param>
</servlet>
</web-app>
